{
  "name": "@liji-table/angular",
  "version": "0.0.10",
  "description": "Angular standalone components (<liji-table>, <liji-table-toolbar>) and RxJS-powered UniversalTable adapter for @liji-table/core.",
  "keywords": [
    "angular",
    "angular-table",
    "datagrid",
    "rxjs",
    "virtualization",
    "liji-table"
  ],
  "type": "module",
  "main": "dist/fesm2022/liji-table-angular.mjs",
  "module": "dist/fesm2022/liji-table-angular.mjs",
  "types": "dist/types/liji-table-angular.d.ts",
  "typings": "dist/types/liji-table-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/liji-table-angular.d.ts",
      "default": "./dist/fesm2022/liji-table-angular.mjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/fesm2022",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-coder21/LIJI-Table.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/next-coder21/LIJI-Table",
  "bugs": "https://github.com/next-coder21/LIJI-Table/issues",
  "scripts": {
    "build": "node -e \"const fs=require('fs'),cp=require('child_process'),raw=fs.readFileSync('package.json','utf8'),pkg=JSON.parse(raw);delete pkg.exports;fs.writeFileSync('package.json',JSON.stringify(pkg,null,2)+'\\n');try{cp.execSync('npx ng-packagr -p ng-package.json',{stdio:'inherit'})}finally{fs.writeFileSync('package.json',raw);['package.json','README.md','LICENSE'].forEach(f=>fs.rmSync('dist/'+f,{force:true}))}\""
  },
  "dependencies": {
    "@liji-table/core": "^0.0.10",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "ng-packagr": "^21.0.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.0",
    "zone.js": "~0.15.0"
  }
}
