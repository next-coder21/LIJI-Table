{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@liji-table/core": ["../core/dist"] 
    },
    "declaration": true,
    "experimentalDecorators": true,
    "lib": ["es2018", "dom"],
    "module": "es2020",
    "moduleResolution": "node",
    "outDir": "../../dist/out-tsc",
    "sourceMap": true,
    "target": "es2015",
    "inlineSources": true
  },
  "angularCompilerOptions": {
    "enableResourceInlining": true,
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true
  }
}